index 6940baf..1fa0767 100644
--- a/src/autofit/afadjust.c
+++ b/src/autofit/afadjust.c
@@ -1148,6 +1148,10 @@
   FT_LOCAL_DEF( FT_UInt32 )
   af_adjustment_database_lookup( FT_UInt32  codepoint )
   {
+    /* crater: skrifa does not adjust diacritics. */
+    FT_UNUSED( codepoint );
+    return 0;
+
     /* Binary search for database entry */
     FT_Offset  low  = 0;
     FT_Offset  high = AF_ADJUSTMENT_DATABASE_LENGTH - 1;
